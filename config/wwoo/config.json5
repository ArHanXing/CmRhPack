/*
WWOO 配置项
本配置用于启用/禁用 William Wythers 重制地形世界模组的各类附加功能！
*/
{
	// 该附加功能修改河流生成逻辑，让河流具备通航出行价值。
	"navigableRivers": true,
	// 该附加功能优化海岸线地貌，生成平缓沙滩海湾、陡峭岩壁崖壁与岩质水洼，让海岸景观更丰富。
	"cliffsAndCoves": true,
	// 该附加功能在毗邻丛林群系的山地区域，新增特普伊桌山地貌。
	"toweringTepuis": false,
	/* 移除安山岩、闪长岩、花岗岩、沙砾、泥土这类地下常规岩层。
	   开启后，上述方块仅能在专属（次级）群系内生成！
	*/
	"removeOres": true
}