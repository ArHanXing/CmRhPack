	quest.1EB8BCAC1496FD10.quest_subtitle: "新石器时代"
	quest.1F3FC4F5B2AA4D48.quest_desc: [
		"在生存难度之下，可以在夜晚进行挖三填一，&m尤其是FCL玩家&r"
