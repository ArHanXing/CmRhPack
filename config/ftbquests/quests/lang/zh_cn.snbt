	quest.14200FFB1A5DDE4F.quest_subtitle: "享受原始"
	quest.1428B5227E4BC37D.quest_desc: ["&a蒸汽裂解&r是将石油烃类或石油馏分在高温与水蒸气作用下&e裂解生成乙烯、丙烯等低分子烯烃&r的核心石化工艺。"]
	quest.14707D8DD61D0627.quest_desc: [
