    "hoveredBackgroundColor": -13421773,
    "borderColor": -12632257,
    "padding": 10,
    "elementSpacing": 5,
    "buttonSpacing": 5,
    "enableDarkTheme": false,
    "showCompletedTasks": true,
    "sortByPriority": false,
    "hudPosition": "TOP_RIGHT",
    "hudWidth": 200,
    "hudMaxHeight": 400,
    "hudTodoLimit": 12,
    "hudDoneLimit": 5,
