{
  "enableHud": true,
  "enableTaskBook": true,
  "enableSoundEffects": true,
  "maxTasksPerPlayer": 100,
  "autoSave": true,
  "autoSaveIntervalMinutes": 5,
  "defaultPriority": "MEDIUM",
  "enableTaskRewards": false,
  "defaultPersonalProjectInitialized": true,
  // commandAccessMode notes:
  // OP_ONLY: only OP can use all commands
  // VIEW_ONLY: non-OP can use view commands, edit still requires OP
  // FULL: non-OP can use view/edit commands (not recommended for public servers)
  "commandAccessMode": "OP_ONLY",
  // storageBackend notes:
  // nbt: deprecated legacy file storage, will be ignored and forced to h2
  // h2: H2 database storage (forced, only supported mode)
  "storageBackend": "h2",
  // h2BackupOnStart notes:
  // false: do not create a startup backup
  // true: create one H2 backup after H2 initializes on startup (default; only effective when storageBackend is h2)
  "h2BackupOnStart": true,
  // h2BackupRetentionCount notes:
  // how many automatic backups (startup backups / pre-restore safety backups) to keep; older ones are deleted automatically (minimum 1)
  "h2BackupRetentionCount": 10,
