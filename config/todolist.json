    "hudCustomX": 10,
    "hudCustomY": 10,
    "hudShowWhenEmpty": false,
    "hudShowSubtasks": true,
    "hudDefaultView": "PERSONAL",
    "hudProjectSource": "CURRENT",
    "hudStarredProjectIds": [],
